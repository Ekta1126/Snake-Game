import java.util.*;
import javax.imageio.ImageIO;
import java.util.Timer;
import java.awt.*;
import java.awt.event.*;
import java.awt.image.*;
import java.io.*;
import javax.swing.*;

class Game extends JPanel {
    private Timer timer;
    private Snake snake;
    private Point cherry;
    private Point bonusCherry;
    private int points = 0;
    private int best = 0;
    private BufferedImage cherryImage;
    private BufferedImage bonusCherryImage;
    private GameStatus status;
    private boolean didLoadCherryImage = true;
    private boolean didLoadBonusImage = true;
    private static final int WIDTH = 760;
    private static final int HEIGHT = 520;
    private static final int DELAY = 50;
    private static final int CELL_SIZE = 20;

    // Fonts for text
    private static final Font FONT_M = new Font("Times New Roman", Font.PLAIN, 24);
    private static final Font FONT_L = new Font("Times New Roman", Font.PLAIN, 84);

    // Constructor
    public Game() {
        try {
            cherryImage = ImageIO.read(new File("cherry.png"));
            bonusCherryImage = ImageIO.read(new File("bonus_cherry.png"));
        } catch (IOException e) {
            didLoadCherryImage = false;
            didLoadBonusImage = false;
        }

        addKeyListener(new KeyListener());
        setFocusable(true);
        setBackground(new Color(34, 139, 34));
        setDoubleBuffered(true);

        snake = new Snake(WIDTH / 2, HEIGHT / 2);
        status = GameStatus.NOT_STARTED;
        repaint();
    }

    @Override
    public void paintComponent(Graphics g) {
        super.paintComponent(g);
        render(g);
        Toolkit.getDefaultToolkit().sync();
    }

    private void update() {
        snake.move();

        // Check if the snake eats the cherry
        if (cherry != null && snake.getHead().intersects(cherry, CELL_SIZE)) {
            snake.addTail();
            cherry = null;
            points++;

            // Speed up the game as the score increases
            if (points % 5 == 0) {
                increaseSpeed();
            }
        }

        // Check if the snake eats the bonus cherry
        if (bonusCherry != null && snake.getHead().intersects(bonusCherry, CELL_SIZE)) {
            snake.addTail();
            bonusCherry = null;
            points += 3;
        }

        // Spawn cherries
        if (cherry == null) {
            spawnCherry();
        }

        if (bonusCherry == null && points > 0 && points % 10 == 0) {
            spawnBonusCherry();
        }

        checkForGameOver();
    }

    private void reset() {
        points = 0;
        cherry = null;
        bonusCherry = null;
        snake = new Snake(WIDTH / 2, HEIGHT / 2);
        setStatus(GameStatus.RUNNING);
    }

    private void setStatus(GameStatus newStatus) {
        switch (newStatus) {
            case RUNNING:
                timer = new Timer();
                timer.schedule(new GameLoop(), 0, DELAY);
                break;
            case PAUSED:
                if (timer != null) {
                    timer.cancel();
                }
                break;
            case GAME_OVER:
                if (timer != null) {
                    timer.cancel();
                }
                best = Math.max(points, best);
                break;
        }
        status = newStatus;
    }

    private void togglePause() {
        setStatus(status == GameStatus.PAUSED ? GameStatus.RUNNING : GameStatus.PAUSED);
    }

    private void checkForGameOver() {
        Point head = snake.getHead();
        boolean hitBoundary = head.getX() < 0 || head.getX() >= WIDTH || head.getY() < 0 || head.getY() >= HEIGHT;

        boolean ateItself = false;
        for (Point t : snake.getTail()) {
            ateItself = ateItself || head.equals(t);
        }

        if (hitBoundary || ateItself) {
            setStatus(GameStatus.GAME_OVER);
        }
    }

    private void spawnCherry() {
        cherry = new Point((new Random()).nextInt(WIDTH / CELL_SIZE) * CELL_SIZE,
                (new Random()).nextInt(HEIGHT / CELL_SIZE) * CELL_SIZE);
    }

    private void spawnBonusCherry() {
        bonusCherry = new Point((new Random()).nextInt(WIDTH / CELL_SIZE) * CELL_SIZE,
                (new Random()).nextInt(HEIGHT / CELL_SIZE) * CELL_SIZE);
    }

    private void render(Graphics g) {
        Graphics2D g2d = (Graphics2D) g;
        
        // Draw grid
        g2d.setColor(new Color(0, 100, 0));
        for (int x = 0; x < WIDTH; x += CELL_SIZE) {
            for (int y = 0; y < HEIGHT; y += CELL_SIZE) {
                g2d.drawRect(x, y, CELL_SIZE, CELL_SIZE);
            }
        }

        // Draw score and best score
        g2d.setColor(Color.WHITE);
        g2d.setFont(FONT_M);
        g2d.drawString("Score: " + points, 20, 30);
        g2d.drawString("Best: " + best, WIDTH - 120, 30);

        // Draw cherries
        if (cherry != null) {
            if (didLoadCherryImage) {
                g2d.drawImage(cherryImage, cherry.getX(), cherry.getY(), CELL_SIZE, CELL_SIZE, null);
            } else {
                g2d.setColor(Color.RED);
                g2d.fillOval(cherry.getX(), cherry.getY(), CELL_SIZE, CELL_SIZE);
            }
        }

        if (bonusCherry != null) {
            if (didLoadBonusImage) {
                g2d.drawImage(bonusCherryImage, bonusCherry.getX(), bonusCherry.getY(), CELL_SIZE, CELL_SIZE, null);
            } else {
                g2d.setColor(Color.YELLOW);
                g2d.fillOval(bonusCherry.getX(), bonusCherry.getY(), CELL_SIZE, CELL_SIZE);
            }
        }

        // Draw snake
        g2d.setColor(Color.BLUE);
        Point head = snake.getHead();
        g2d.fillRect(head.getX(), head.getY(), CELL_SIZE, CELL_SIZE);

        for (Point t : snake.getTail()) {
            g2d.fillRect(t.getX(), t.getY(), CELL_SIZE, CELL_SIZE);
        }

        // Draw game over screen
        if (status == GameStatus.GAME_OVER) {
            g2d.setFont(FONT_L);
            g2d.setColor(Color.RED);
            String message = "GAME OVER";
            int messageWidth = g2d.getFontMetrics().stringWidth(message);
            g2d.drawString(message, (WIDTH - messageWidth) / 2, HEIGHT / 2);
        }
    }

    private void increaseSpeed() {
        if (timer != null) {
            timer.cancel();
            timer = new Timer();
            timer.schedule(new GameLoop(), 0, Math.max(DELAY - points, 10));
        }
    }

    private class KeyListener extends KeyAdapter {
        @Override
        public void keyPressed(KeyEvent e) {
            int key = e.getKeyCode();

            if (status == GameStatus.RUNNING) {
                switch (key) {
                    case KeyEvent.VK_LEFT:
                        snake.turn(Direction.LEFT);
                        break;
                    case KeyEvent.VK_RIGHT:
                        snake.turn(Direction.RIGHT);
                        break;
                    case KeyEvent.VK_UP:
                        snake.turn(Direction.UP);
                        break;
                    case KeyEvent.VK_DOWN:
                        snake.turn(Direction.DOWN);
                        break;
                }
            }

            if (status == GameStatus.NOT_STARTED) {
                setStatus(GameStatus.RUNNING);
            }

            if (status == GameStatus.GAME_OVER && key == KeyEvent.VK_ENTER) {
                reset();
            }

            if (key == KeyEvent.VK_P) {
                togglePause();
            }
        }
    }

    private class GameLoop extends TimerTask {
        public void run() {
            update();
            repaint();
        }
    }
}

// Enum for game status
enum GameStatus {
    NOT_STARTED, RUNNING, PAUSED, GAME_OVER
}

// Enum for snake direction
enum Direction {
    UP, DOWN, LEFT, RIGHT;

    public boolean isX() {
        return this == LEFT || this == RIGHT;
    }

    public boolean isY() {
        return this == UP || this == DOWN;
    }
}

// Point class for handling positions
class Point {
    private int x;
    private int y;

    public Point(int x, int y) {
        this.x = x;
        this.y = y;
    }

    public int getX() {
        return x;
    }

    public int getY() {
        return y;
    }

    public void move(Direction d, int value) {
        switch (d) {
            case UP:
                this.y -= value;
                break;
            case DOWN:
                this.y += value;
                break;
            case LEFT:
                this.x -= value;
                break;
            case RIGHT:
                this.x += value;
                break;
        }
    }

    public boolean intersects(Point p, int tolerance) {
        return Math.abs(this.x - p.getX()) < tolerance && Math.abs(this.y - p.getY()) < tolerance;
    }

    public boolean equals(Point p) {
        return this.x == p.getX() && this.y == p.getY();
    }
}

// Snake class
class Snake {
    private Direction direction;
    private Point head;
    private ArrayList<Point> tail;

    public Snake(int x, int y) {
        this.head = new Point(x, y);
        this.direction = Direction.RIGHT;
        this.tail = new ArrayList<>();
        this.tail.add(new Point(x - 20, y));
        this.tail.add(new Point(x - 40, y));
    }

    public void move() {
        Point prevHead = new Point(head.getX(), head.getY());
        head.move(direction, 20);

        for (int i = tail.size() - 1; i > 0; i--) {
            tail.set(i, tail.get(i - 1));
        }
        if (!tail.isEmpty()) {
            tail.set(0, prevHead);
        }
    }

    public void addTail() {
        Point last = tail.isEmpty() ? head : tail.get(tail.size() - 1);
        tail.add(new Point(last.getX(), last.getY()));
    }

    public void turn(Direction d) {
        if ((d.isX() && direction.isY()) || (d.isY() && direction.isX())) {
            direction = d;
        }
    }

    public Point getHead() {
        return head;
    }

    public ArrayList<Point> getTail() {
        return tail;
    }
}

public class Main extends JFrame {
    public Main() {
        initUI();
    }

    private void initUI() {
        add(new Game());
        setTitle("Enhanced Snake Game");
        setSize(800, 600);
        setLocationRelativeTo(null);
        setResizable(false);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
    }

    public static void main(String[] args) {
        EventQueue.invokeLater(() -> {
            Main ex = new Main();
            ex.setVisible(true);
        });
    }
}
